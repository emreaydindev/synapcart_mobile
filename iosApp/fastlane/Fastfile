# SynapCart iOS release lanes. Run from iosApp/:  bundle exec fastlane <lane>
#
# Auth uses an App Store Connect API key (no Apple ID password / 2FA):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (base64 of the .p8), and TEAM_ID.
# Signing: `match` (MATCH_GIT_URL, MATCH_PASSWORD) when configured, otherwise automatic
# signing with the API key (-allowProvisioningUpdates).

default_platform(:ios)

platform :ios do
  before_all do
    sh("cd .. && xcodegen generate")
  end

  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  def build(configuration:, scheme: "SynapCart")
    if ENV["MATCH_GIT_URL"]
      match(type: "appstore", readonly: is_ci, api_key: asc_key)
    end
    build_app(
      project: "SynapCart.xcodeproj",
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV.fetch('TEAM_ID')}",
      output_directory: "build",
      clean: true
    )
  end

  desc "Unit tests on the simulator"
  lane :test do
    run_tests(project: "SynapCart.xcodeproj", scheme: "SynapCart", device: "iPhone 16")
  end

  desc "Staging build (staging-api) to TestFlight"
  lane :beta_staging do
    key = asc_key
    increment_build_number(build_number: latest_testflight_build_number(api_key: key) + 1, xcodeproj: "SynapCart.xcodeproj")
    build(configuration: "Staging", scheme: "SynapCart Staging")
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Production build (api.synapcart.emreaydin.dev) to TestFlight"
  lane :beta do
    key = asc_key
    increment_build_number(build_number: latest_testflight_build_number(api_key: key) + 1, xcodeproj: "SynapCart.xcodeproj")
    build(configuration: "Release")
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true)
  end

  desc "Upload the latest build and metadata for App Store review (no auto-release)"
  lane :release do
    key = asc_key
    build(configuration: "Release")
    upload_to_app_store(
      api_key: key,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end
end
